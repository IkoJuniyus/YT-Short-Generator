<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>YT Short Generator - Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="dashboard-container">
    <!-- Header -->
    <header class="dashboard-header">
      <div class="header-content">
        <h1>🎬 YT Short Generator</h1>
        <p class="subtitle">AI-powered YouTube Shorts creation & upload</p>
      </div>
      <nav class="nav-tabs">
        <button class="nav-btn active" onclick="showTab('upload')">Upload New</button>
        <button class="nav-btn" onclick="showTab('queue')"> queued Uploads (<span id="queueCount">0</span>)</button>
        <button class="nav-btn" onclick="showTab('history')">History</button>
        <button class="nav-btn" onclick="showTab('settings')">Settings</button>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="dashboard-content">
      
      <!-- Upload Tab -->
      <div id="tab-upload" class="tab-content active">
        <div class="input-section">
          <div class="input-group">
            <input type="text" id="urlInput" placeholder="Paste YouTube URL here..." autocomplete="off">
            <button id="generateBtn" onclick="startGenerate()">Generate Shorts</button>
          </div>
        </div>

        <div id="status-section" class="status-section hidden">
          <div class="status-card">
            <div class="video-info" id="videoInfo"></div>
            <div class="progress-container">
              <div class="progress-bar">
                <div class="progress-fill" id="progressBar"></div>
              </div>
              <div class="progress-text">
                <span id="stageText">Waiting...</span>
                <span id="progressPct">0%</span>
              </div>
            </div>
          </div>
        </div>

        <div id="results-section" class="results-section hidden">
          <h2>Generated Shorts</h2>
          <div id="shortsList" class="shorts-grid"></div>
        </div>

        <div id="error-section" class="error-section hidden">
          <div class="error-card">
            <span class="error-icon">&#x26A0;</span>
            <span id="errorText"></span>
          </div>
        </div>

        <div id="log-section" class="log-section hidden">
          <h3>Process Logs</h3>
          <div id="logs" class="log-container"></div>
        </div>
      </div>

      <!-- Queue Tab -->
      <div id="tab-queue" class="tab-content hidden">
        <div class="queue-header">
          <h2>Queued Uploads</h2>
          <div class="queue-controls">
            <button class="btn btn-sm" onclick="clearQueue()">Clear All</button>
          </div>
        </div>
        <div id="queueList" class="queue-grid"></div>
      </div>

      <!-- History Tab -->
      <div id="tab-history" class="tab-content hidden">
        <div class="history-header">
          <h2>Job History</h2>
          <span class="count-badge" id="historyCount">0 jobs</span>
        </div>
        <div id="historyList" class="history-list"></div>
      </div>

      <!-- Settings Tab -->
      <div id="tab-settings" class="tab-content hidden">
        <div class="settings-card">
          <h2>YouTube Settings</h2>
          <div class="setting-row">
            <span class="setting-label">Auto-Upload</span>
            <span class="setting-value" id="uploadEnabled">Disabled</span>
          </div>
          <div class="setting-row">
            <span class="setting-label">Privacy</span>
            <span class="setting-value" id="privacySetting">private</span>
          </div>
          <button class="btn btn-primary" onclick="window.location.href='/youtube/authorize'">
            🔗 Reconnect YouTube
          </button>
        </div>

        <div class="settings-card">
          <h2>App Settings</hparameter>
          <div class="setting-row">
            <span class="setting-label">Port</span>
            <span class="setting-value">3000</span>
          </div>
          <div class="setting-row">
            <span class="setting-label">Node Version</span>
            <span class="setting-value" id="nodeVersion"></span>
          </div>
          <div class="setting-row">
            <span class="setting-label">yt-dlp</span>
            <span class="setting-value" id="ytdlpVersion"></span>
          </div>
        </div>
      </div>

    </main>
  </div>
  <script src="/js/app.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
