{
  "name": "yt-short",
  "version": "1.0.0",
  "description": "Auto YouTube Shorts generator — paste a URL, get multiple vertical short clips automatically",
  "main": "app.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "auth:youtube": "node scripts/auth-youtube.js",
    "postinstall": "if [ ! -f .env ]; then cp .env.example .env 2>/dev/null || copy .env.example .env >nul 2>&1; fi"
  },
  "keywords": [
    "youtube",
    "shorts",
    "auto-clip",
    "ffmpeg",
    "yt-dlp",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^189.0.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
